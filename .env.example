# Reference configuration for IT. This file contains placeholders only.
# Copy the required values to `.env` for local development. In a Windows service,
# prefer process environment variables or Credential Manager for passwords as
# described in docs/DEPLOYMENT.md. Never put real passwords, tokens, or AWS
# keys in this project folder.

# Main SQL Server. The source defaults are used when host/database are omitted.
# Store the longtat password securely under this Credential Manager target.
SQL_SERVER_CREDENTIAL_TARGET=ESQ_LEFTOVER_SQL
# SQL_SERVER_HOST=
# SQL_SERVER_DATABASE=ESQ_DATA
# SQL_SERVER_USER=                     # avoid: use Credential Manager instead
# SQL_SERVER_PASSWORD=                 # never save a real password here
SQL_SERVER_DRIVER=pymssql
SQL_SERVER_ENCRYPT=true
SQL_SERVER_TRUST_SERVER_CERTIFICATE=false
SQL_SERVER_REQUIRE_ENCRYPTION=false
SQL_SERVER_TIMEOUT_SEC=15
SQL_SERVER_QUERY_TIMEOUT_SEC=45

# Inventory stock source (separate RDS database/view; required for verified allocation)
STOCK_SQL_CREDENTIAL_TARGET=COI_STOCK_SQL
STOCK_SQL_SERVER=esq-mssql-std-dm.cogfagymhkon.ap-southeast-2.rds.amazonaws.com
STOCK_SQL_DATABASE=ESCM_EGV_EAV
STOCK_SQL_SCHEMA=invsubmat
STOCK_SQL_VIEW=V_Inv_Stock_EGV_EAV
# STOCK_SQL_USER=
# STOCK_SQL_PASSWORD=
STOCK_SQL_DRIVER=pymssql
STOCK_SQL_ENCRYPT=true
STOCK_SQL_TRUST_SERVER_CERTIFICATE=false
STOCK_SQL_REQUIRE_ENCRYPTION=false
STOCK_SQL_TIMEOUT_SEC=15
STOCK_SQL_QUERY_TIMEOUT_SEC=45

# Optional shipment / on-the-way SQL source. It has a separate read-only login.
SHIPMENT_SQL_CREDENTIAL_TARGET=TEST_SHIPMENT_SQL
# SHIPMENT_SQL_SERVER_HOST=EGVNT04
# SHIPMENT_SQL_SERVER_USER=
# SHIPMENT_SQL_SERVER_PASSWORD=
SHIPMENT_SQL_SERVER_DRIVER=pymssql
SHIPMENT_SQL_SERVER_ENCRYPT=true
SHIPMENT_SQL_SERVER_TRUST_SERVER_CERTIFICATE=false
SHIPMENT_SQL_SERVER_REQUIRE_ENCRYPTION=false

# Optional GW/Sale Reservation source. It has a separate login.
GW_CREDENTIAL_TARGET=TEST_GW_LOGIN
# GW_LOGIN_USER=
# GW_LOGIN_PASSWORD=

# Runtime paths. Use a writable local folder for the cache and a valid OneDrive
# COI destination on the server that issues workbooks.
# TEST_CACHE_DIR=C:\TEST-COI\data\cache
# ONEDRIVE_COI_FOLDER_PATH=C:\CompanyData\COI PPC
# SHAREPOINT_COI_FOLDER_URL=

# Trusted internal-LAN service. API token authentication is intentionally off
# for this private deployment; never bind this configuration to a public network.
APP_HOST=0.0.0.0
APP_PORT=5070
APP_THREADS=24
APP_ALLOW_LAN_WITHOUT_TOKEN=true
# Vite dev UI origins allowed to call POST/PUT APIs through the local proxy.
# Add any separately hosted trusted UI origin as a comma-separated value.
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COI_API_ALLOWED_ORIGINS=*

# Optional operational tuning. Keep source refresh enabled for real-time data.
SQL_SOURCE_CACHE_MAX_AGE_SEC=900
SOURCE_REFRESH_INTERVAL_SEC=5
SOURCE_REFRESH_BATCH_SIZE=20
SNAPSHOT_BATCH_SIZE=25
INLINE_SNAPSHOT_MAX_WORKERS=2
GO_FEED_PAGE_SIZE=500
GO_FEED_RECENT_LIMIT=2000
GO_FEED_RECENT_SYNC_INTERVAL_SEC=300
STOCK_BALANCE_QUERY_TIMEOUT_SEC=120
STOCK_BALANCE_RETRY_TIMEOUT_SEC=180

# AWS credentials are not used by the current TEST COI application.
# AWS_PROFILE=
# AWS_DEFAULT_REGION=
